# Copy to `.env` (git-ignored) and fill in. Only EXPO_PUBLIC_* values are
# bundled into the app, so NEVER put the Supabase secret / service_role key here.

# Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://pnxzcywtjucanmwmmvsr.supabase.co
# The *publishable* key (sb_publishable_…) or legacy anon key.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Finnhub (https://finnhub.io/dashboard) — live prices over WebSocket + REST quotes.
EXPO_PUBLIC_FINNHUB_API_KEY=

# Optional: EAS project id (from `npx eas init`) — required for Expo push tokens.
EAS_PROJECT_ID=
