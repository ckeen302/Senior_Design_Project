# Secrets for the fetch-sec-filings Edge Function.
# Hosted:  supabase secrets set --env-file supabase/functions/.env
# Local:   supabase functions serve --env-file supabase/functions/.env
# (SUPABASE_URL and the Supabase API keys are injected automatically.)

# Required by SEC fair-access policy: app/organisation name + contact email.
SEC_USER_AGENT="InsiderPulse Senior Design Project you@example.com"

# Shared secret used by the pg_cron job (x-ingest-secret header). Must match the
# Vault secret "insiderpulse_ingest_secret". Generate with: openssl rand -hex 32
INGEST_SECRET=

# Optional: refreshes company market caps (the WISI denominator) from Finnhub.
FINNHUB_API_KEY=

# Optional: Expo push security token (https://expo.dev/accounts/_/settings/access-tokens).
EXPO_ACCESS_TOKEN=

# Optional: minimum CEO/CFO open-market purchase (USD) that triggers a whale alert.
WHALE_ALERT_MIN_USD=1000000
